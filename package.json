{
  "name": "keurkompas",
  "private": true,
  "version": "0.1.0",
  "description": "KeurKompas — offline-first veldapp voor BEPO-keuringen van opslagtanks (VLAREM II, hfdst. 5.17).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "docs:rules": "vite-node scripts/generate-rules-doc.ts",
    "build:preview": "vite build --mode preview-artifact && node scripts/inline-preview.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "exifr": "^7.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
