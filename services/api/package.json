{
  "name": "@tankwijzer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for Tankwijzer (owners). Inspectors (KeurKompas) get a separate auth realm.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "reminders": "tsx --env-file-if-exists=../../.env src/jobs/send-reminders.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tankwijzer/ai": "workspace:*",
    "@tankwijzer/vlarem-core": "workspace:*",
    "hono": "^4.9.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
