# Copy to .env and fill in. Never commit real keys.
# On Netlify, set the same variables under Site configuration > Environment variables.

# Claude API key for photo reading, document extraction, pre-check and "Vraag het".
# Leave empty to run with AI disabled (the app then asks the owner to fill in values manually).
ANTHROPIC_API_KEY=

# Local only: where the API stores its SQLite database, uploads and outbox.
# (On Netlify the data lives in Netlify Database and Netlify Blobs.)
DATA_DIR=.data

# Public URL of the web app. Optional: when empty, the address of each request is used.
APP_URL=http://localhost:5173

# Inspection body that receives booking requests (email in v1).
INSPECTION_BODY_EMAIL=planning@example.be

# Test mode: show the login link on screen instead of only emailing it.
# Anyone can then log in as any email address: never use it with real customer data.
DEV_MAGIC_LINK=1

# Real email (needed when DEV_MAGIC_LINK is off): Brevo, an EU-based email service.
# Locally, without BREVO_API_KEY, emails are written to DATA_DIR/outbox.
BREVO_API_KEY=
MAIL_FROM=Tankwijzer <noreply@uwdomein.be>

# Largest upload in MB (Netlify: 4, the default there; locally 15).
# MAX_UPLOAD_MB=4
