# Copy to .env and fill in. Never commit real keys.

# Claude API key for photo reading, document extraction, pre-check and "Vraag het".
# Leave empty to run with AI disabled (the app then asks the owner to fill in values manually).
ANTHROPIC_API_KEY=

# Where the API stores its SQLite database and uploaded files (host this in the EU).
DATA_DIR=.data

# Public URL of the web app (used in magic-link emails and .ics links).
APP_URL=http://localhost:5173

# Inspection body that receives booking requests (email in v1).
INSPECTION_BODY_EMAIL=planning@example.be

# Development only: return the magic link in the API response instead of emailing it.
DEV_MAGIC_LINK=1

# SMTP is not wired yet; emails are written to the console and to DATA_DIR/outbox.
